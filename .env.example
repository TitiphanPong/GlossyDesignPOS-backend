PORT=8080
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/glossy-pos

# Private upload storage
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_S3_BUCKET_PRIVATE=glossy-pos-private-uploads
AWS_S3_KMS_KEY_ID=

# Bootstrap credentials used only to create the first backend admin account.
# Change/remove the bootstrap password after the account has been created.
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Optional dedicated automation account. Created only when both values are set.
# Keep this password in deployment/local secret storage; never commit the real value.
# AGENT_LOGIN_ROLE defaults to staff and may be staff, manager, or admin.
AGENT_LOGIN_USERNAME=glossy-agent
AGENT_LOGIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
AGENT_LOGIN_ROLE=staff

# LINE Official Account / Messaging API
LINE_CHANNEL_ID=REPLACE_ME
LINE_CHANNEL_SECRET=REPLACE_ME
LINE_CHANNEL_ACCESS_TOKEN=REPLACE_ME

# LINE Login / LIFF identity verification
LINE_LOGIN_CHANNEL_ID=REPLACE_ME
LINE_LOGIN_CHANNEL_SECRET=REPLACE_ME

ORDER_NUMBER_TIMEZONE=Asia/Bangkok
